*.pdb filter=lfs diff=lfs merge=lfs -text
.github/workflows/*.yml text eol=lf
crates/forge3d-web/tests/infrastructure/*.json text eol=lf
crates/forge3d-web/tests/infrastructure/*.mjs text eol=lf
docs/parity/*.json text eol=lf
crates/forge3d-web/tests/parity/*.json text eol=lf
crates/forge3d-web/tests/parity/*.mjs text eol=lf
scripts/*.mjs text eol=lf
tools/browser-lab-controller/services/*.mjs text eol=lf
tools/browser-lab-controller/services/*.ps1 text eol=lf
crates/forge3d-web/tests/golden/*.bin binary
crates/forge3d-web/tests/golden/w07/*.f32 binary
crates/forge3d-web/tests/golden/w07/*.png binary
*.rgba binary
*.f32 binary
crates/forge3d-web/tests/golden/w11/native/*.wgsl text eol=lf
crates/forge3d-web/tests/golden/w11/native/*.rs text eol=lf

crates/forge3d-web/tests/golden/w10/source/**/*.wgsl text eol=lf
crates/forge3d-web/tests/golden/w10/source/**/*.rs text eol=lf
crates/forge3d-web/tests/golden/w10/source/**/*.png binary

# W13 assets are digest-pinned; preserve upstream bytes on every platform.
crates/forge3d-web/assets/harfbuzz/** -text
crates/forge3d-web/assets/fonts/** -text
crates/forge3d-web/assets/harfbuzz/provenance.json text eol=lf
crates/forge3d-web/assets/fonts/provenance.json text eol=lf
crates/forge3d-web/assets/harfbuzz/index.d.mts text eol=lf
crates/forge3d-web/tests/golden/w12/native/** -text
crates/forge3d-web/assets/w12/*.json text eol=lf

# W13 native test snapshots retain the exact pinned Git blob bytes.
crates/forge3d-web/tests/golden/w13/native/** -text

# W13 package outputs are regenerated by prepare-dist on Windows and macOS.
crates/forge3d-web/types/label-*.d.ts text eol=lf
crates/forge3d-web/types/labels.d.ts text eol=lf
crates/forge3d-web/types/typography.d.ts text eol=lf
crates/forge3d-web/docs/label-case-contract.json text eol=lf

# W14 hashes preserve the raw upstream modules, database, grids and native blobs.
crates/forge3d-web/assets/proj/** -text
# Preserve the digest-pinned upstream notices, including Markdown hard breaks.
crates/forge3d-web/assets/proj/GRID-LICENSE.txt -whitespace
crates/forge3d-web/assets/proj/PROJ-COPYING -whitespace
crates/forge3d-web/assets/datasets/** -text
crates/forge3d-web/assets/proj/provenance.json text eol=lf
crates/forge3d-web/assets/datasets/provenance.json text eol=lf
crates/forge3d-web/tests/golden/w14/native/** -text
crates/forge3d-web/tests/fixtures/w14/*.json text eol=lf
crates/forge3d-web/types/crs*.d.ts text eol=lf
crates/forge3d-web/types/dataset*.d.ts text eol=lf
crates/forge3d-web/types/vector*.d.ts text eol=lf
crates/forge3d-web/tests/fixtures/w14/provenance.json text eol=lf
crates/forge3d-web/assets/datasets/remote-storage.json text eol=lf

# W15 IO fixtures and archived controls are byte/digest pinned.
crates/forge3d-web/tests/fixtures/w15/** -text
