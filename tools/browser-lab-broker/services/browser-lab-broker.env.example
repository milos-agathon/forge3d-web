BROKER_HOST=127.0.0.1
BROKER_PORT=8443
BROKER_HARDWARE_MATRIX=/etc/forge3d/hardware-matrix.json
BROKER_BROWSER_POLICY=/etc/forge3d/browser-policy.json
BROKER_REPOSITORY_TRUST_POLICY=/etc/forge3d/repository-trust-policy.json
BROKER_WORKFLOW_ACTIONS_LOCK=/etc/forge3d/workflow-actions-lock.json
BROKER_CONTROLLER_HEALTH_ENDPOINTS=/etc/forge3d/controller-health-endpoints.json
BROKER_AUTHORIZATION_DIRECTORY=/var/lib/forge3d-browser-lab-broker/authorizations
BROKER_LEDGER_PATH=/var/lib/forge3d-browser-lab-broker/ledger.json
BROKER_GITHUB_APP_ID=REPLACE_WITH_NUMERIC_APP_ID
BROKER_GITHUB_INSTALLATION_ID=REPLACE_WITH_NUMERIC_INSTALLATION_ID
BROKER_GITHUB_PRIVATE_KEY_PATH=/etc/forge3d/secrets/registration-broker.pem
BROKER_TLS_KEY_PATH=/etc/forge3d/secrets/broker-tls.key
BROKER_TLS_CERT_PATH=/etc/forge3d/broker-tls.crt
BROKER_TLS_CA_PATH=/etc/forge3d/controller-ca.crt
BROKER_CONTROLLER_HEALTH_CLIENT_KEY_PATH=/etc/forge3d/secrets/broker-controller-health.key
BROKER_CONTROLLER_HEALTH_CLIENT_CERT_PATH=/etc/forge3d/broker-controller-health.crt
BROKER_CONTROLLER_HEALTH_CA_PATH=/etc/forge3d/controller-health-ca.crt
BROKER_INSTALLATION_RECEIPT=/etc/forge3d/broker-installation-receipt.json
BROKER_PACKAGE_MANIFEST=/etc/forge3d/broker-package-manifest.json
