[Unit]
Description=Forge3D browser-lab JIT registration broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=forge3d-broker
Group=forge3d-broker
EnvironmentFile=/etc/forge3d/browser-lab-broker.env
Environment=BROKER_PACKAGE_ROOT=/opt/forge3d/browser-lab-broker
Environment=BROKER_PACKAGE_ARCHIVE_PATH=/opt/forge3d/browser-lab-broker-package/browser-lab-broker.tar.gz
Environment=BROKER_CONFIGURATION_ROOT=/etc/forge3d/browser-lab-broker-config
WorkingDirectory=/opt/forge3d/browser-lab-broker
ExecStart=/usr/bin/node /opt/forge3d/browser-lab-broker/src/bootstrap.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
SystemCallArchitectures=native
ReadOnlyPaths=/opt/forge3d/browser-lab-broker /opt/forge3d/browser-lab-broker-package /etc/forge3d
ReadWritePaths=/var/lib/forge3d-browser-lab-broker

[Install]
WantedBy=multi-user.target
