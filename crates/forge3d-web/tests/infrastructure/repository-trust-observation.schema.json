{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge3d.dev/schemas/repository-trust-observation.schema.json",
  "title": "Forge3D repository trust observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repository",
    "operation",
    "consumers",
    "workflow",
    "run",
    "candidateSha",
    "targetSha",
    "currentMainSha",
    "trustEpochSha",
    "policySha256",
    "workflowActionsLockSha256",
    "requiredChecks",
    "liveResponses",
    "nonce",
    "observedAt",
    "expiresAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fullName"],
      "properties": {
        "id": { "const": 1259761852 },
        "fullName": { "const": "milos-agathon/forge3d-web" }
      }
    },
    "operation": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["job", "environment"],
        "properties": {
          "job": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "environment": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          }
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "ref", "sha"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^\\.github/workflows/[A-Za-z0-9_.-]+\\.ya?ml$"
        },
        "ref": { "const": "refs/heads/main" },
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "attempt"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "attempt": { "type": "integer", "minimum": 1 }
      }
    },
    "candidateSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "targetSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "currentMainSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "trustEpochSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "policySha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "workflowActionsLockSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "requiredChecks": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "conclusion", "sourceAppId"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "name": { "type": "string", "minLength": 1 },
          "conclusion": { "const": "success" },
          "sourceAppId": { "const": 15368 }
        }
      }
    },
    "liveResponses": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "endpoint", "sha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "endpoint": { "type": "string", "pattern": "^/repos/" },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "observedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "expiresAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    }
  }
}
