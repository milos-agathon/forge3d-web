{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge3d.dev/schemas/manual-session.schema.json",
  "title": "Forge3D controller-signed manual browser session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repository",
    "workflow",
    "workflowSha",
    "run",
    "hardwareJobId",
    "authorizationSha256",
    "intakeManifestSha256",
    "runner",
    "trustedSha",
    "package",
    "labReadiness",
    "hostId",
    "assetId",
    "controllerKeyId",
    "system",
    "browser",
    "driver",
    "headed",
    "loginSession",
    "origins",
    "routeBasePath",
    "mediaChallenge",
    "startedAt",
    "endedAt",
    "cleanup"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repository": { "const": "milos-agathon/forge3d-web" },
    "workflow": { "const": ".github/workflows/browser-hardware.yml" },
    "workflowSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "attempt"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "attempt": { "type": "integer", "minimum": 1 }
      }
    },
    "hardwareJobId": { "type": "integer", "minimum": 1 },
    "authorizationSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "intakeManifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "trustedSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "promotionRunId", "sha256", "harnessSha256"],
      "properties": {
        "runId": { "type": "integer", "minimum": 1 },
        "promotionRunId": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "harnessSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "labReadiness": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["runId", "labInfrastructureDigest"],
      "properties": {
        "runId": { "type": "integer", "minimum": 1 },
        "labInfrastructureDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "hostId": { "type": "string", "pattern": "^FW-(?:MAC|WIN|LNX)-[A-Z0-9-]+$" },
    "assetId": { "type": "string", "pattern": "^FW-[A-Z0-9-]+$" },
    "controllerKeyId": { "type": "string", "minLength": 1 },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "build"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "build": { "type": "string", "minLength": 1 }
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "channel", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "channel": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "driver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "headed": { "const": true },
    "loginSession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interactive", "locked", "remote"],
      "properties": {
        "interactive": { "const": true },
        "locked": { "const": false },
        "remote": { "const": false }
      }
    },
    "origins": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application", "asset"],
      "properties": {
        "application": { "type": "string", "pattern": "^https://" },
        "asset": { "type": "string", "pattern": "^https://" }
      }
    },
    "routeBasePath": {
      "type": "string",
      "pattern": "^/runs/[1-9][0-9]*/[1-9][0-9]*/[0-9a-f]{32}/$"
    },
    "mediaChallenge": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "startedAt": { "type": "string", "minLength": 20 },
    "endedAt": { "type": "string", "minLength": 20 },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "browserStopped",
        "driverStopped",
        "fixtureStopped",
        "tunnelStopped",
        "updatesRestored",
        "runnerAbsent"
      ],
      "properties": {
        "browserStopped": { "const": true },
        "driverStopped": { "const": true },
        "fixtureStopped": { "const": true },
        "tunnelStopped": { "const": true },
        "updatesRestored": { "const": true },
        "runnerAbsent": { "const": true }
      }
    }
  }
}
