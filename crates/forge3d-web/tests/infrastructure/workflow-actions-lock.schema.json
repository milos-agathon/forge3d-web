{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge3d.dev/schemas/workflow-actions-lock.schema.json",
  "title": "Forge3D reviewed GitHub Actions lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewedAt", "actions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "reviewedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "path",
          "commit",
          "upstreamVersion",
          "reviewedAt"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "path": {
            "type": "string",
            "pattern": "^(|[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*)$"
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "upstreamVersion": { "type": "string", "minLength": 1 },
          "reviewedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    }
  }
}
