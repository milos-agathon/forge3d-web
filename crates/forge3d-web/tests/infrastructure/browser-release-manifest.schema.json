{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge3d.dev/schemas/browser-release-manifest.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordType",
    "supportClaim",
    "targetSha",
    "tag",
    "readiness",
    "manualMediaPlanSha256",
    "assets",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recordType": { "const": "browser-release-candidate" },
    "supportClaim": { "const": true },
    "targetSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "sha256"],
      "properties": {
        "runId": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "manualMediaPlanSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "createdAt": { "type": "string", "minLength": 20 }
  }
}
