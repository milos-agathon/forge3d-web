{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge3d.dev/schemas/manual-media-sources.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "targetSha", "intakes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "targetSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "intakes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidenceArtifactId",
          "releaseId",
          "tagName",
          "targetCommitish",
          "draft",
          "intakeManifest",
          "media"
        ],
        "properties": {
          "evidenceArtifactId": { "type": "integer", "minimum": 1 },
          "releaseId": { "type": "integer", "minimum": 1 },
          "tagName": { "type": "string", "pattern": "^manual-evidence-intake-[1-9][0-9]*$" },
          "targetCommitish": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "draft": { "const": true },
          "intakeManifest": {
            "type": "object",
            "additionalProperties": false,
            "required": ["assetId", "sha256"],
            "properties": {
              "assetId": { "type": "integer", "minimum": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          },
          "media": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "assetId",
                "originalName",
                "finalName",
                "uploader",
                "size",
                "mimeType",
                "createdAt",
                "apiSha256",
                "sha256"
              ],
              "properties": {
                "assetId": { "type": "integer", "minimum": 1 },
                "originalName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
                "finalName": { "type": "string", "pattern": "^manual-media-[1-9][0-9]*-[1-9][0-9]*-[A-Za-z0-9][A-Za-z0-9._-]*$" },
                "uploader": { "type": "string", "minLength": 1 },
                "size": { "type": "integer", "minimum": 1 },
                "mimeType": { "type": "string", "minLength": 1 },
                "createdAt": { "type": "string", "minLength": 20 },
                "apiSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          }
        }
      }
    }
  }
}
