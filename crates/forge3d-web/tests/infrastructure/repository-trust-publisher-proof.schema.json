{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge3d.dev/schemas/repository-trust-publisher-proof.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifact", "observation", "attestation"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "archiveSha256", "contentSha256", "expired", "workflowRun", "archiveMember"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
        "archiveSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "contentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "expired": { "const": false },
        "workflowRun": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "repositoryId", "headRepositoryId", "headBranch", "headSha"],
          "properties": {
            "id": { "type": "integer", "minimum": 1 },
            "repositoryId": { "type": "integer", "minimum": 1 },
            "headRepositoryId": { "type": "integer", "minimum": 1 },
            "headBranch": { "const": "main" },
            "headSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          }
        },
        "archiveMember": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "name", "sha256", "canonicalJson"],
          "properties": {
            "count": { "const": 1 },
            "name": { "const": "repository-trust-observation.json" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "canonicalJson": { "const": true }
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "operation", "consumers", "workflow", "run", "candidateSha", "targetSha", "currentMainSha", "trustEpochSha", "policySha256", "workflowActionsLockSha256", "repositorySettings", "observedAt", "expiresAt"],
      "properties": {
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "fullName"],
          "properties": {
            "id": { "const": 1259761852 },
            "fullName": { "const": "milos-agathon/forge3d-web" }
          }
        },
        "operation": { "type": "string", "minLength": 1 },
        "consumers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["job", "environment"],
            "properties": {
              "job": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
              "environment": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" }
            }
          }
        },
        "workflow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "ref", "sha"],
          "properties": {
            "path": { "type": "string", "pattern": "^\\.github/workflows/[A-Za-z0-9_.-]+\\.ya?ml$" },
            "ref": { "const": "refs/heads/main" },
            "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          }
        },
        "run": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "attempt"],
          "properties": {
            "id": { "type": "integer", "minimum": 1 },
            "attempt": { "type": "integer", "minimum": 1 }
          }
        },
        "candidateSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "targetSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "currentMainSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "trustEpochSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "policySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "workflowActionsLockSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "repositorySettings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["immutableReleases"],
          "properties": {
            "immutableReleases": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "enforcedByOwner"],
              "properties": {
                "enabled": { "const": true },
                "enforcedByOwner": { "type": "boolean" }
              }
            }
          }
        },
        "observedAt": { "type": "string", "minLength": 20 },
        "expiresAt": { "type": "string", "minLength": 20 }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "repository", "signerWorkflow", "sourceRef", "sourceDigest", "denySelfHostedRunners"],
      "properties": {
        "verified": { "const": true },
        "repository": { "const": "milos-agathon/forge3d-web" },
        "signerWorkflow": { "type": "string", "minLength": 1 },
        "sourceRef": { "const": "refs/heads/main" },
        "sourceDigest": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "denySelfHostedRunners": { "const": true }
      }
    }
  }
}
