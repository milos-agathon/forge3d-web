{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge3d.dev/schemas/runner-distribution-manifest.schema.json",
  "title": "Forge3D GitHub Actions runner distribution manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runnerVersion", "generatedAt", "distributions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runnerVersion": { "const": "2.336.0" },
    "generatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "distributions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform",
          "archiveFileName",
          "archiveSha256",
          "entries"
        ],
        "properties": {
          "platform": {
            "enum": ["linux-x64", "osx-arm64", "win-x64"]
          },
          "archiveFileName": { "type": "string", "minLength": 1 },
          "archiveSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "entries": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "type",
                "size",
                "mode",
                "sha256",
                "target"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
                },
                "type": { "enum": ["directory", "file", "symlink"] },
                "size": { "type": "integer", "minimum": 0 },
                "mode": {
                  "type": "string",
                  "pattern": "^[0-7]{4}$"
                },
                "sha256": {
                  "type": ["null", "string"],
                  "pattern": "^[0-9a-f]{64}$"
                },
                "target": { "type": ["null", "string"] }
              }
            }
          }
        }
      }
    }
  }
}
