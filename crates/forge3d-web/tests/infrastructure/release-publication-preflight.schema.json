{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge3d.dev/schemas/release-publication-preflight.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "supportClaim",
    "repository",
    "workflow",
    "workflowSha",
    "run",
    "targetSha",
    "tag",
    "readiness",
    "observation",
    "assets",
    "publisher",
    "implementationActors",
    "createdAt",
    "expiresAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "mode": { "enum": ["supported-release", "laboratory-canary"] },
    "supportClaim": { "type": "boolean" },
    "repository": { "const": "milos-agathon/forge3d-web" },
    "workflow": { "type": "string", "minLength": 1 },
    "workflowSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "attempt"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "attempt": { "type": "integer", "minimum": 1 }
      }
    },
    "targetSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "tag": { "type": "string", "minLength": 1 },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "artifactId", "sha256", "status"],
      "properties": {
        "runId": { "type": "integer", "minimum": 1 },
        "artifactId": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "status": {
          "enum": ["RELEASE_MATRIX_READY", "LAB_CANARY_PREFLIGHT_READY"]
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "artifactName",
        "artifactDigest",
        "contentSha256"
      ],
      "properties": {
        "artifactId": { "type": "integer", "minimum": 1 },
        "artifactName": { "type": "string", "minLength": 1 },
        "artifactDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "contentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "name", "sha256"],
        "properties": {
          "sourceId": { "type": "integer", "minimum": 1 },
          "name": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job", "environment", "actor", "approvers"],
      "properties": {
        "job": { "type": "string", "minLength": 1 },
        "environment": { "const": "forge3d-web-release" },
        "actor": { "type": "string", "minLength": 1 },
        "approvers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "login"],
            "properties": {
              "id": { "type": "integer", "minimum": 1 },
              "login": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "implementationActors": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "createdAt": { "type": "string", "minLength": 20 },
    "expiresAt": { "type": "string", "minLength": 20 }
  }
}
