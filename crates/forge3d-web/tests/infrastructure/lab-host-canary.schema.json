{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge3d.dev/schemas/lab-host-canary.schema.json",
  "title": "Forge3D finalized host laboratory canary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordType",
    "runId",
    "runAttempt",
    "lane",
    "canaryMode",
    "hostId",
    "assetId",
    "trustedSha",
    "packageRunId",
    "packageSha256",
    "result",
    "supportAssertionsExecuted",
    "adapter",
    "adapterAttestation",
    "authorization",
    "controller",
    "runner",
    "cleanup",
    "inventory",
    "route",
    "attestation",
    "finalizer"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recordType": { "const": "host-lab-canary" },
    "runId": { "type": "integer", "minimum": 1 },
    "runAttempt": { "type": "integer", "minimum": 1 },
    "lane": { "const": "infrastructure-canary" },
    "canaryMode": { "const": "host" },
    "hostId": { "$ref": "#/$defs/assetId" },
    "assetId": { "$ref": "#/$defs/assetId" },
    "trustedSha": { "$ref": "#/$defs/sha40" },
    "packageRunId": { "type": "integer", "minimum": 1 },
    "packageSha256": { "$ref": "#/$defs/sha256" },
    "result": { "const": "PASS" },
    "supportAssertionsExecuted": { "const": false },
    "adapter": { "$ref": "#/$defs/pageAdapter" },
    "adapterAttestation": { "$ref": "#/$defs/adapterAttestation" },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "attested"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "attested": { "const": true }
      }
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signatureVerified", "signingKeyId"],
      "properties": {
        "signatureVerified": { "const": true },
        "signingKeyId": { "type": "string", "minLength": 1 }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "acceptedJobCount", "absentAfterRun"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1 },
        "acceptedJobCount": { "const": 1 },
        "absentAfterRun": { "const": true }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete"],
      "properties": {
        "complete": { "const": true }
      }
    },
    "inventory": { "$ref": "#/$defs/inventory" },
    "route": { "$ref": "#/$defs/route" },
    "attestation": { "$ref": "#/$defs/hostedAttestation" },
    "finalizer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run",
        "job",
        "environment",
        "absenceObservations",
        "observedAt"
      ],
      "properties": {
        "run": { "$ref": "#/$defs/run" },
        "job": { "const": "finalize-hardware-evidence" },
        "environment": { "const": "forge3d-trust-observer" },
        "absenceObservations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/absenceObservation" }
        },
        "observedAt": { "$ref": "#/$defs/timestamp" }
      }
    }
  },
  "$defs": {
    "assetId": {
      "type": "string",
      "pattern": "^FW-(?:MAC|WIN|LNX)-[A-Z0-9-]+$"
    },
    "sha40": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "minLength": 20
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "attempt"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "attempt": { "type": "integer", "minimum": 1 }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "jobId", "assetId", "commit", "packageSha256"],
      "properties": {
        "runId": { "type": "integer", "minimum": 1 },
        "jobId": { "type": "integer", "minimum": 1 },
        "assetId": { "$ref": "#/$defs/assetId" },
        "commit": { "$ref": "#/$defs/sha40" },
        "packageSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "pageAdapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "runId",
        "jobId",
        "assetId",
        "commit",
        "packageSha256",
        "navigatorGpu",
        "adapterInfoAvailable",
        "adapterInfo",
        "isFallbackAdapter",
        "deviceAdapterInfo",
        "limits",
        "deviceCreated",
        "surfaceCreated",
        "surfacePresented",
        "presentedFrameLuma",
        "lumaChanged",
        "effectiveLaunchArguments"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "runId": { "type": "integer", "minimum": 1 },
        "jobId": { "type": "integer", "minimum": 1 },
        "assetId": { "$ref": "#/$defs/assetId" },
        "commit": { "$ref": "#/$defs/sha40" },
        "packageSha256": { "$ref": "#/$defs/sha256" },
        "navigatorGpu": { "const": true },
        "adapterInfoAvailable": { "const": true },
        "adapterInfo": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          }
        },
        "isFallbackAdapter": { "const": false },
        "deviceAdapterInfo": {
          "type": ["object", "null"],
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "deviceCreated": { "const": true },
        "surfaceCreated": { "const": true },
        "surfacePresented": { "const": true },
        "presentedFrameLuma": { "type": "number", "exclusiveMinimum": 0.05 },
        "lumaChanged": { "const": true },
        "effectiveLaunchArguments": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interactive", "locked", "remote", "identifier"],
      "properties": {
        "interactive": { "const": true },
        "locked": { "const": false },
        "remote": { "const": false },
        "identifier": { "type": "string", "minLength": 1 }
      }
    },
    "hostAdapterEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "lane",
        "runId",
        "jobId",
        "assetId",
        "commit",
        "packageSha256",
        "hostId",
        "platform",
        "expectedGpu",
        "expectedGpuPresent",
        "headedSessionAvailable",
        "osBuild",
        "session",
        "inventoryCapturedAt",
        "commandEvidence",
        "capturedAt"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "lane": { "const": "infrastructure-canary" },
        "runId": { "type": "integer", "minimum": 1 },
        "jobId": { "type": "integer", "minimum": 1 },
        "assetId": { "$ref": "#/$defs/assetId" },
        "commit": { "$ref": "#/$defs/sha40" },
        "packageSha256": { "$ref": "#/$defs/sha256" },
        "hostId": { "$ref": "#/$defs/assetId" },
        "platform": { "enum": ["darwin", "win32", "linux"] },
        "expectedGpu": { "type": "string", "minLength": 1 },
        "expectedGpuPresent": { "const": true },
        "headedSessionAvailable": { "const": true },
        "osBuild": { "type": "string", "minLength": 1 },
        "session": { "$ref": "#/$defs/session" },
        "inventoryCapturedAt": { "$ref": "#/$defs/timestamp" },
        "commandEvidence": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        },
        "capturedAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "adapterAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "binding", "required", "result", "page", "host"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "binding": { "$ref": "#/$defs/binding" },
        "required": { "const": true },
        "result": { "const": "PASS" },
        "page": { "$ref": "#/$defs/pageAdapter" },
        "host": { "$ref": "#/$defs/hostAdapterEvidence" }
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "channel",
        "classification",
        "automation",
        "version",
        "executable"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "channel": {
          "enum": [
            "stable",
            "beta",
            "technology-preview",
            "release",
            "nightly"
          ]
        },
        "classification": { "enum": ["required", "probe"] },
        "automation": { "enum": ["playwright", "safaridriver", "selenium"] },
        "version": { "type": "string", "minLength": 1 },
        "executable": { "type": "string", "minLength": 1 }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "assetId",
        "platform",
        "osBuild",
        "headed",
        "displayServer",
        "session",
        "browsers",
        "tools",
        "effectiveLaunchArguments",
        "prohibitedLaunchArgumentsPresent",
        "capturedAt",
        "hostId",
        "attachedAssetIds"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "assetId": { "$ref": "#/$defs/assetId" },
        "platform": { "enum": ["darwin", "win32", "linux"] },
        "osBuild": { "type": "string", "minLength": 1 },
        "headed": { "const": true },
        "displayServer": { "type": "string", "minLength": 1 },
        "session": { "$ref": "#/$defs/session" },
        "browsers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/browser" }
        },
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "required": ["playwright", "selenium", "geckodriver"],
          "properties": {
            "playwright": { "type": "string", "minLength": 1 },
            "selenium": { "type": "string", "minLength": 1 },
            "geckodriver": { "type": "string", "minLength": 1 },
            "appium": { "type": "string", "minLength": 1 },
            "appiumUiAutomator2": { "type": "string", "minLength": 1 },
            "appiumXcuitest": { "type": "string", "minLength": 1 },
            "safaridriverPath": { "type": "string", "minLength": 1 },
            "safaridriverVersion": { "type": "string", "minLength": 1 }
          }
        },
        "effectiveLaunchArguments": {
          "type": "array",
          "items": { "type": "string" }
        },
        "prohibitedLaunchArgumentsPresent": {
          "type": "array",
          "maxItems": 0,
          "items": { "type": "string" }
        },
        "capturedAt": { "$ref": "#/$defs/timestamp" },
        "hostId": { "$ref": "#/$defs/assetId" },
        "attachedAssetIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^FW-[A-Z0-9-]+$"
          }
        }
      }
    },
    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorized",
        "authorizationError",
        "subject",
        "issuer",
        "validFrom",
        "validTo",
        "fingerprint256"
      ],
      "properties": {
        "authorized": { "const": true },
        "authorizationError": { "type": ["string", "null"] },
        "subject": { "type": ["string", "null"] },
        "issuer": { "type": "string", "minLength": 1 },
        "validFrom": { "type": "string", "minLength": 1 },
        "validTo": { "type": "string", "minLength": 1 },
        "fingerprint256": { "type": "string", "minLength": 1 }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "applicationHost",
        "assetHost",
        "basePath",
        "packageSha256",
        "certificates",
        "httpsVerified",
        "corsRangeControlsPassed"
      ],
      "properties": {
        "ok": { "const": true },
        "applicationHost": {
          "type": "string",
          "pattern": "^[a-z0-9-]+\\.webgpu-ci\\.forge3d\\.dev$"
        },
        "assetHost": {
          "type": "string",
          "pattern": "^[a-z0-9-]+\\.webgpu-ci\\.forge3d\\.dev$"
        },
        "basePath": {
          "type": "string",
          "pattern": "^/runs/[1-9][0-9]*/[1-9][0-9]*/[0-9a-f]{32}/$"
        },
        "packageSha256": { "$ref": "#/$defs/sha256" },
        "certificates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["application", "asset"],
          "properties": {
            "application": { "$ref": "#/$defs/certificate" },
            "asset": { "$ref": "#/$defs/certificate" }
          }
        },
        "httpsVerified": { "const": true },
        "corsRangeControlsPassed": { "const": true }
      }
    },
    "hostedAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verified",
        "denySelfHostedRunners",
        "repository",
        "signerWorkflow",
        "sourceRef",
        "sourceDigest"
      ],
      "properties": {
        "verified": { "const": true },
        "denySelfHostedRunners": { "const": true },
        "repository": { "const": "milos-agathon/forge3d-web" },
        "signerWorkflow": {
          "const": "milos-agathon/forge3d-web/.github/workflows/browser-hardware.yml"
        },
        "sourceRef": { "const": "refs/heads/main" },
        "sourceDigest": { "$ref": "#/$defs/sha40" }
      }
    },
    "absenceObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "sha256", "observedAt"],
      "properties": {
        "status": { "enum": [200, 404] },
        "sha256": { "$ref": "#/$defs/sha256" },
        "observedAt": { "$ref": "#/$defs/timestamp" }
      }
    }
  }
}
