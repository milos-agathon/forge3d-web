{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge3d.dev/schemas/browser-policy.schema.json",
  "title": "Forge3D browser lab runner policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "provisioningState",
    "runnerVersion",
    "repositoryJitRunnerGroupId",
    "jitWorkFolder",
    "brokerProtocolVersion",
    "cleanupProtocolVersion",
    "acceptanceWindowHours",
    "headedSessionRequired",
    "prohibitedLaunchArguments",
    "channels",
    "tools",
    "archives",
    "runnerDistributionManifestSha256",
    "runnerTransientPathPolicySha256"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "provisioningState": { "enum": ["pending-jit-canary", "active"] },
    "runnerVersion": { "const": "2.336.0" },
    "repositoryJitRunnerGroupId": { "const": 1 },
    "jitWorkFolder": { "const": "_work" },
    "brokerProtocolVersion": { "const": "forge3d-browser-lab-broker/v1" },
    "cleanupProtocolVersion": { "const": "forge3d-browser-lab-cleanup/v1" },
    "acceptanceWindowHours": { "const": 24 },
    "headedSessionRequired": { "const": true },
    "prohibitedLaunchArguments": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "string",
        "pattern": "^--[a-z0-9-]+$"
      }
    },
    "channels": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "browser",
          "channel",
          "classification",
          "minimumMajor",
          "automation"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "browser": {
            "enum": ["chrome", "edge", "safari", "firefox"]
          },
          "channel": {
            "enum": [
              "stable",
              "beta",
              "technology-preview",
              "release",
              "nightly"
            ]
          },
          "classification": { "enum": ["required", "probe"] },
          "minimumMajor": { "type": "integer", "minimum": 26 },
          "automation": {
            "enum": ["playwright", "safaridriver", "selenium"]
          }
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "playwright",
        "selenium",
        "geckodriver",
        "appium",
        "appiumUiAutomator2",
        "appiumXcuitest",
        "safaridriverPath"
      ],
      "properties": {
        "playwright": { "$ref": "#/$defs/version" },
        "selenium": { "$ref": "#/$defs/version" },
        "geckodriver": { "$ref": "#/$defs/version" },
        "appium": { "$ref": "#/$defs/version" },
        "appiumUiAutomator2": { "$ref": "#/$defs/version" },
        "appiumXcuitest": { "$ref": "#/$defs/version" },
        "safaridriverPath": { "const": "/usr/bin/safaridriver" }
      }
    },
    "archives": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "fileName", "url", "sha256"],
        "properties": {
          "platform": { "enum": ["linux-x64", "osx-arm64", "win-x64"] },
          "fileName": { "type": "string", "minLength": 1 },
          "url": {
            "type": "string",
            "pattern": "^https://github\\.com/actions/runner/releases/download/v2\\.336\\.0/"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "runnerDistributionManifestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runnerTransientPathPolicySha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  }
}
