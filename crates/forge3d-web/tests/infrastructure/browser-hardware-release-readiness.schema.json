{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge3d.dev/schemas/browser-hardware-release-readiness.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "supportClaim",
    "targetSha",
    "packageRunId",
    "packageSha256",
    "labReadiness",
    "requiredKeys",
    "recordDigests",
    "evidenceRunIds",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "const": "RELEASE_MATRIX_READY" },
    "supportClaim": { "const": true },
    "targetSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "packageRunId": { "type": "integer", "minimum": 1 },
    "packageSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "labReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "manifestSha256", "labInfrastructureDigest"],
      "properties": {
        "runId": { "type": "integer", "minimum": 1 },
        "manifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "labInfrastructureDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "requiredKeys": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": { "type": "string", "minLength": 1 }
    },
    "recordDigests": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "workflowRunId", "artifactId", "sha256"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "workflowRunId": { "type": "integer", "minimum": 1 },
          "artifactId": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "evidenceRunIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 1 }
    },
    "createdAt": { "type": "string", "minLength": 20 }
  }
}
