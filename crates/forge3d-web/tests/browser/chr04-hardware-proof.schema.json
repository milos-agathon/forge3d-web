{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge3d.dev/schemas/chr04-hardware-proof-v1.json",
  "title": "Forge3D CHR-04 Edge hardware proof v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "binding",
    "behaviors",
    "driver",
    "visibility",
    "terrainSource",
    "screenshot",
    "lifecycleCycles",
    "errors",
    "benchmark",
    "systemInfo",
    "edgeAcceptance"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "forge3d-chr04-edge-hardware-proof-v1"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane",
        "assetId",
        "platform",
        "commit",
        "packageSha256"
      ],
      "properties": {
        "lane": {
          "enum": [
            "edge-windows-intel12",
            "edge-macos-m2",
            "edge-linux-intel12",
            "edge-linux-rtx3070"
          ]
        },
        "assetId": {
          "enum": [
            "FW-WIN-I12-01",
            "FW-MAC-M2-01",
            "FW-LNX-I12-01",
            "FW-LNX-NV-01"
          ]
        },
        "platform": {
          "enum": [
            "win32",
            "darwin",
            "linux"
          ]
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "packageSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "behaviors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orbit",
        "pan",
        "wheelZoom",
        "pointerCapture",
        "keyboard",
        "autoResize",
        "visibilityResume",
        "terrainSource",
        "screenshot",
        "disposal"
      ],
      "properties": {
        "orbit": {
          "const": true
        },
        "pan": {
          "const": true
        },
        "wheelZoom": {
          "const": true
        },
        "pointerCapture": {
          "const": true
        },
        "keyboard": {
          "const": true
        },
        "autoResize": {
          "const": true
        },
        "visibilityResume": {
          "const": true
        },
        "terrainSource": {
          "const": true
        },
        "screenshot": {
          "const": true
        },
        "disposal": {
          "const": true
        }
      }
    },
    "driver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orbitChanged",
        "panChanged",
        "wheelChanged",
        "pointerCapture",
        "keyboard",
        "autoResize"
      ],
      "properties": {
        "orbitChanged": {
          "const": true
        },
        "panChanged": {
          "const": true
        },
        "wheelChanged": {
          "const": true
        },
        "pointerCapture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pointerId",
            "capturedPointerId",
            "releasedPointerId",
            "captured",
            "outsideMoveChanged",
            "released",
            "activePointersAfter"
          ],
          "properties": {
            "pointerId": {
              "type": "integer",
              "minimum": 1
            },
            "capturedPointerId": {
              "type": "integer",
              "minimum": 1
            },
            "releasedPointerId": {
              "type": "integer",
              "minimum": 1
            },
            "captured": {
              "const": true
            },
            "outsideMoveChanged": {
              "const": true
            },
            "released": {
              "const": true
            },
            "activePointersAfter": {
              "const": 0
            }
          }
        },
        "keyboard": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "orbit",
            "pan",
            "zoomIn",
            "zoomOut",
            "reset"
          ],
          "properties": {
            "orbit": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "changed"
              ],
              "properties": {
                "key": {
                  "const": "ArrowRight"
                },
                "changed": {
                  "const": true
                }
              }
            },
            "pan": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "changed"
              ],
              "properties": {
                "key": {
                  "const": "Shift+ArrowRight"
                },
                "changed": {
                  "const": true
                }
              }
            },
            "zoomIn": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "changed"
              ],
              "properties": {
                "key": {
                  "const": "Equal"
                },
                "changed": {
                  "const": true
                }
              }
            },
            "zoomOut": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "changed"
              ],
              "properties": {
                "key": {
                  "const": "Minus"
                },
                "changed": {
                  "const": true
                }
              }
            },
            "reset": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "changed"
              ],
              "properties": {
                "key": {
                  "const": "Home"
                },
                "changed": {
                  "const": true
                }
              }
            }
          }
        },
        "autoResize": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observerActive",
            "dimensionsChanged",
            "submittedFrame"
          ],
          "properties": {
            "observerActive": {
              "const": true
            },
            "dimensionsChanged": {
              "const": true
            },
            "submittedFrame": {
              "const": true
            }
          }
        }
      }
    },
    "visibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "cycleCount",
        "hiddenObserved",
        "visibleObserved",
        "submittedEveryCycle"
      ],
      "properties": {
        "source": {
          "const": "actual-document"
        },
        "cycleCount": {
          "const": 30
        },
        "hiddenObserved": {
          "const": true
        },
        "visibleObserved": {
          "const": true
        },
        "submittedEveryCycle": {
          "const": true
        }
      }
    },
    "terrainSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api",
        "url",
        "crossOrigin",
        "width",
        "height",
        "byteLength",
        "progressEvents",
        "completed",
        "submittedFrame"
      ],
      "properties": {
        "api": {
          "const": "setTerrainFromSource"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "crossOrigin": {
          "const": true
        },
        "width": {
          "const": 512
        },
        "height": {
          "const": 512
        },
        "byteLength": {
          "const": 1048576
        },
        "progressEvents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "loaded",
              "total",
              "done"
            ],
            "properties": {
              "loaded": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1048576
              },
              "total": {
                "const": 1048576
              },
              "done": {
                "type": "boolean"
              }
            }
          }
        },
        "completed": {
          "const": true
        },
        "submittedFrame": {
          "const": true
        }
      }
    },
    "screenshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mimeType",
        "byteLength",
        "sha256",
        "width",
        "height"
      ],
      "properties": {
        "mimeType": {
          "const": "image/png"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "lifecycleCycles": {
      "type": "array",
      "minItems": 50,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cycle",
          "runtimeIdentity",
          "submittedFrames",
          "afterDispose"
        ],
        "properties": {
          "cycle": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "runtimeIdentity": {
            "type": "string",
            "minLength": 1
          },
          "submittedFrames": {
            "type": "integer",
            "minimum": 1
          },
          "afterDispose": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ownedListeners",
              "activeObservers",
              "activePointers",
              "activeRuntimes",
              "pendingAnimationFrame",
              "ownedAnimationFrameCount"
            ],
            "properties": {
              "ownedListeners": {
                "const": 0
              },
              "activeObservers": {
                "const": 0
              },
              "activePointers": {
                "const": 0
              },
              "activeRuntimes": {
                "const": 0
              },
              "pendingAnimationFrame": {
                "const": false
              },
              "ownedAnimationFrameCount": {
                "const": 0
              }
            }
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "maxItems": 0
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "manifestSha256",
        "terrainSha256",
        "traceSha256",
        "canvasCssWidth",
        "canvasCssHeight",
        "backingWidth",
        "backingHeight",
        "devicePixelRatio",
        "browserZoomBefore",
        "browserZoomAfter",
        "viewportScaleBefore",
        "viewportScaleAfter",
        "traceVersion",
        "visibilityStateBefore",
        "visibilityStateAfter",
        "documentHasFocusBefore",
        "documentHasFocusAfter",
        "visibilityChangeCount",
        "windowBlurCount",
        "thermalStateBefore",
        "thermalStateAfter",
        "thermalSignalProvenance",
        "lowPowerModeBefore",
        "lowPowerModeAfter",
        "lowPowerSignalProvenance",
        "warmupSamples",
        "measurementSamples",
        "rafTimestampsMs",
        "rafIntervalsMs",
        "traceSamplesApplied",
        "catchUpSamples",
        "submittedFramesBefore",
        "submittedFramesAfter",
        "submittedFramesDelta",
        "skippedFramesBefore",
        "skippedFramesAfter",
        "skippedFramesDelta",
        "measuredDurationMs",
        "framesPerSecond",
        "p95RafIntervalMs",
        "scheduling"
      ],
      "properties": {
        "id": {
          "const": "forge3d-viewer-benchmark-v1"
        },
        "manifestSha256": {
          "const": "17493b8dc4ca3f1c43b7dc9ffbe50400d0980de20d6bb3c6a564f457eb4c6a4f"
        },
        "terrainSha256": {
          "const": "f7ac944a3dc3736384f1082bec5f850b45d88c36ca675e9c543d945d8741e5c6"
        },
        "traceSha256": {
          "const": "bcef9611960ee1b0f25be529d416135ca65ec2d0571049eca1b282e6e9ad905d"
        },
        "canvasCssWidth": {
          "const": 320
        },
        "canvasCssHeight": {
          "const": 320
        },
        "backingWidth": {
          "const": 640
        },
        "backingHeight": {
          "const": 640
        },
        "devicePixelRatio": {
          "const": 2
        },
        "traceVersion": {
          "const": 1
        },
        "browserZoomBefore": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "browserZoomAfter": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "viewportScaleBefore": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "viewportScaleAfter": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "visibilityStateBefore": {
          "type": "string"
        },
        "visibilityStateAfter": {
          "type": "string"
        },
        "documentHasFocusBefore": {
          "type": "boolean"
        },
        "documentHasFocusAfter": {
          "type": "boolean"
        },
        "visibilityChangeCount": {
          "type": "integer",
          "minimum": 0
        },
        "windowBlurCount": {
          "type": "integer",
          "minimum": 0
        },
        "thermalStateBefore": {
          "enum": [
            "nominal",
            "fair",
            "serious",
            "critical",
            "unavailable"
          ]
        },
        "thermalStateAfter": {
          "enum": [
            "nominal",
            "fair",
            "serious",
            "critical",
            "unavailable"
          ]
        },
        "thermalSignalProvenance": {
          "type": "string",
          "minLength": 1
        },
        "lowPowerModeBefore": {
          "enum": [
            false,
            true,
            "unavailable"
          ]
        },
        "lowPowerModeAfter": {
          "enum": [
            false,
            true,
            "unavailable"
          ]
        },
        "lowPowerSignalProvenance": {
          "type": "string",
          "minLength": 1
        },
        "warmupSamples": {
          "const": 120
        },
        "measurementSamples": {
          "const": 600
        },
        "rafTimestampsMs": {
          "type": "array",
          "minItems": 601,
          "maxItems": 601,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "rafIntervalsMs": {
          "type": "array",
          "minItems": 600,
          "maxItems": 600,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "traceSamplesApplied": {
          "const": 600
        },
        "catchUpSamples": {
          "const": 0
        },
        "submittedFramesBefore": {
          "type": "integer",
          "minimum": 0
        },
        "submittedFramesAfter": {
          "type": "integer",
          "minimum": 0
        },
        "submittedFramesDelta": {
          "const": 600
        },
        "skippedFramesBefore": {
          "type": "integer",
          "minimum": 0
        },
        "skippedFramesAfter": {
          "type": "integer",
          "minimum": 0
        },
        "skippedFramesDelta": {
          "const": 0
        },
        "measuredDurationMs": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "framesPerSecond": {
          "type": "number",
          "minimum": 0
        },
        "p95RafIntervalMs": {
          "type": "number",
          "minimum": 0
        },
        "scheduling": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observationSamples",
            "pendingBeforeInvalidation",
            "pendingAfterInvalidation",
            "maxOutstandingFrames",
            "finalOutstandingFrames",
            "duplicateRafObserved"
          ],
          "properties": {
            "observationSamples": {
              "const": 600
            },
            "pendingBeforeInvalidation": {
              "type": "integer",
              "minimum": 0
            },
            "pendingAfterInvalidation": {
              "type": "integer",
              "minimum": 0
            },
            "maxOutstandingFrames": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1
            },
            "finalOutstandingFrames": {
              "const": 0
            },
            "duplicateRafObserved": {
              "const": false
            }
          }
        }
      }
    },
    "systemInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "diagnosticOnly",
        "value",
        "unavailableReason"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "diagnosticOnly": {
          "const": true
        },
        "value": {
          "type": [
            "object",
            "null"
          ]
        },
        "unavailableReason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "edgeAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "synthetic",
        "physicalPolicyProof",
        "touch",
        "unsupported"
      ],
      "properties": {
        "kind": {
          "const": "forge3d-chr04-edge-browser-diagnostics-v1"
        },
        "synthetic": {
          "const": true
        },
        "physicalPolicyProof": {
          "const": false
        },
        "touch": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "injectedAtBrowserBoundary",
            "pointerType",
            "pointerId",
            "viewChanged",
            "activePointersAfter",
            "disposed"
          ],
          "properties": {
            "injectedAtBrowserBoundary": {
              "const": true
            },
            "pointerType": {
              "const": "touch"
            },
            "pointerId": {
              "const": 73
            },
            "viewChanged": {
              "const": true
            },
            "activePointersAfter": {
              "const": 0
            },
            "disposed": {
              "const": true
            }
          }
        },
        "unsupported": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "missingApi",
            "nullAdapter",
            "unrelated"
          ],
          "properties": {
            "missingApi": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "thrownCode",
                "publicCode",
                "status",
                "unsupportedVisible",
                "adapterIntercepted",
                "hasBypassAdvice",
                "bypassLinks"
              ],
              "properties": {
                "thrownCode": {
                  "const": "WEBGPU_UNAVAILABLE"
                },
                "publicCode": {
                  "const": "WEBGPU_UNAVAILABLE"
                },
                "status": {
                  "const": "unsupported"
                },
                "unsupportedVisible": {
                  "const": true
                },
                "adapterIntercepted": {
                  "const": null
                },
                "hasBypassAdvice": {
                  "const": false
                },
                "bypassLinks": {
                  "const": 0
                }
              }
            },
            "nullAdapter": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "thrownCode",
                "publicCode",
                "status",
                "unsupportedVisible",
                "adapterIntercepted",
                "hasBypassAdvice",
                "bypassLinks",
                "recovered"
              ],
              "properties": {
                "thrownCode": {
                  "const": "WEBGPU_ADAPTER_UNAVAILABLE"
                },
                "publicCode": {
                  "const": "WEBGPU_ADAPTER_UNAVAILABLE"
                },
                "status": {
                  "const": "unsupported"
                },
                "unsupportedVisible": {
                  "const": true
                },
                "adapterIntercepted": {
                  "const": true
                },
                "hasBypassAdvice": {
                  "const": false
                },
                "bypassLinks": {
                  "const": 0
                },
                "recovered": {
                  "const": true
                }
              }
            },
            "unrelated": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "status",
                "unsupportedVisible"
              ],
              "properties": {
                "code": {
                  "const": "WASM_LOAD_FAILED"
                },
                "status": {
                  "const": "WASM_LOAD_FAILED"
                },
                "unsupportedVisible": {
                  "const": false
                }
              }
            }
          }
        }
      }
    }
  }
}
